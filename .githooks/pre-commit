#!/bin/bash
# Refuse to commit anything that could contain personal task data.
bad='^(tasks\.db|status\.json|config\.json|daemon\.log|NOTES\.md|\.claude_heartbeat|inbox_local/|inbox_failed/|exports/|launchd\.)'
hits="$(git diff --cached --name-only | grep -E "$bad" || true)"
if [ -n "$hits" ]; then
  echo "pre-commit: refusing to commit personal data files:"; echo "$hits" | sed 's/^/  /'
  echo "unstage them: git restore --staged <file>"; exit 1
fi
# No .json file belongs in this repo: every one is either config or a task command.
jsons="$(git diff --cached --name-only | grep -E '\.json$' || true)"
if [ -n "$jsons" ]; then
  echo "pre-commit: staged .json files look like task commands or config. Refusing:"; echo "$jsons" | sed 's/^/  /'; exit 1
fi
